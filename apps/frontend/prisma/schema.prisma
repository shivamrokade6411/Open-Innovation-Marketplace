// Prisma Schema for Open Innovation Marketplace
// Author: Antigravity Pair Programmer
// Date: 2026-08-14

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  PARTICIPANT
  COMPANY
  JUDGE
  ADMIN
}

enum CompanyMemberRole {
  OWNER
  MEMBER
}

enum ChallengeStatus {
  DRAFT
  UPCOMING
  OPEN
  SUBMISSION_CLOSED
  JUDGING
  COMPLETED
  CANCELLED
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  SHORTLISTED
  FINALIST
  WINNER
  RUNNER_UP
  REJECTED
}

enum NotificationType {
  CHALLENGE
  SUBMISSION
  MESSAGE
  PAYMENT
  SYSTEM
  ACHIEVEMENT
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum MessageType {
  TEXT
  FILE
  IMAGE
  SYSTEM
}

enum TeamMemberRole {
  LEADER
  MEMBER
}

enum CertificateType {
  WINNER
  PARTICIPANT
  FINALIST
}

enum PaymentType {
  SUBSCRIPTION
  PRIZE
  WITHDRAWAL
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentGateway {
  RAZORPAY
  STRIPE
}

// ==========================================
// MODELS
// ==========================================

model User {
  id              String   @id @default(uuid())
  name            String
  email           String   @unique
  username        String?  @unique
  passwordHash    String
  role            UserRole @default(PARTICIPANT)
  avatar          String?
  bio             String?
  location        String?
  website         String?
  githubUrl       String?
  linkedinUrl     String?
  twitterUrl      String?
  portfolioUrl    String?
  skills          String[] @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  profile          Profile?
  companyMembers   CompanyMember[]
  submissions      Submission[]
  teamMembers      TeamMember[]
  savedChallenges  SavedChallenge[]
  notifications    Notification[]
  sentMessages     Message[]
  achievements     UserAchievement[]
  payments         Payment[]
  payouts          PrizePayout[]
  applications     Application[]
  judges           Judge[]
  scores           SubmissionScore[]
  comments         SubmissionComment[]
  contracts        Contract[]
}

model Profile {
  id             String   @id @default(uuid())
  userId         String   @unique
  bio            String?
  skills         String[] @default([])
  portfolioLinks String[] @default([])
  totalWins      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Company {
  id                 String   @id @default(uuid())
  name               String
  slug               String   @unique
  logo               String?
  coverImage         String?
  description        String?
  website            String?
  industry           String?
  location           String?
  verified           Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relations
  members            CompanyMember[]
  challenges         Challenge[]
  jobs               JobOpportunity[]
  contracts          Contract[]
}

model CompanyMember {
  id        String            @id @default(uuid())
  companyId String
  userId    String
  role      CompanyMemberRole @default(MEMBER)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
}

model Challenge {
  id                   String            @id @default(uuid())
  title                String
  slug                 String            @unique
  shortDescription     String
  description          String
  problemStatement     String
  expectedSolution     String
  companyId            String
  industry             String?
  status               ChallengeStatus   @default(DRAFT)
  prizePool            Float             @default(0.0)
  maxTeamSize          Int               @default(1)
  registrationDeadline DateTime
  submissionDeadline   DateTime
  judgingDeadline      DateTime
  winnerAnnouncement   DateTime
  eligibility          String?
  submissionGuidelines String?
  judgingCriteria      String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  publishedAt          DateTime?

  // Relations
  company              Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  skills               ChallengeSkill[]
  timeline             ChallengeTimeline[]
  prizes               ChallengePrize[]
  submissions          Submission[]
  teams                Team[]
  savedBy              SavedChallenge[]
  judges               Judge[]
  rubrics              JudgingRubric[]
  notifications        Notification[]
}

model Skill {
  id              String           @id @default(uuid())
  name            String           @unique
  createdAt       DateTime         @default(now())

  // Relations
  challenges      ChallengeSkill[]
}

model ChallengeSkill {
  id          String    @id @default(uuid())
  challengeId String
  skillId     String

  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  skill       Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([challengeId, skillId])
}

model ChallengeTimeline {
  id          String    @id @default(uuid())
  challengeId String
  title       String
  date        DateTime
  description String?
  createdAt   DateTime  @default(now())

  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
}

model ChallengePrize {
  id          String    @id @default(uuid())
  challengeId String
  place       Int       // e.g. 1 for first place
  amount      Float
  description String?
  createdAt   DateTime  @default(now())

  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  payouts     PrizePayout[]
}

model Submission {
  id            String             @id @default(uuid())
  challengeId   String
  userId        String
  teamId        String?
  title         String
  description   String
  solutionUrl   String?
  githubUrl     String?
  videoUrl      String?
  pdfUrl        String?
  techStack     String[]           @default([])
  status        SubmissionStatus   @default(DRAFT)
  score         Float              @default(0.0)
  aiScore       Float              @default(0.0)
  aiFeedback    String?
  reviewNotes   String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  // Relations
  challenge     Challenge          @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  team          Team?              @relation(fields: [teamId], references: [id], onDelete: SetNull)
  files         SubmissionFile[]
  versions      SubmissionVersion[]
  scores        SubmissionScore[]
  comments      SubmissionComment[]
}

model SubmissionFile {
  id           String     @id @default(uuid())
  submissionId String
  fileUrl      String
  fileName     String
  fileSize     Int?
  createdAt    DateTime   @default(now())

  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model SubmissionVersion {
  id           String     @id @default(uuid())
  submissionId String
  version      Int
  description  String?
  createdAt    DateTime   @default(now())

  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model Team {
  id          String       @id @default(uuid())
  name        String
  challengeId String
  inviteCode  String       @unique
  maxMembers  Int          @default(4)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relations
  challenge   Challenge    @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  members     TeamMember[]
  submissions Submission[]
}

model TeamMember {
  id        String         @id @default(uuid())
  teamId    String
  userId    String
  role      TeamMemberRole @default(MEMBER)
  joinedAt  DateTime       @default(now())

  team      Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

model SavedChallenge {
  id          String    @id @default(uuid())
  userId      String
  challengeId String
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId])
}

model Judge {
  id          String    @id @default(uuid())
  userId      String
  challengeId String
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId])
}

model JudgingRubric {
  id          String             @id @default(uuid())
  challengeId String
  title       String
  description String?
  createdAt   DateTime           @default(now())

  challenge   Challenge          @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  criteria    JudgingCriterion[]
}

model JudgingCriterion {
  id          String        @id @default(uuid())
  rubricId    String
  title       String
  description String?
  maxPoints   Int           @default(10)
  weight      Float         @default(1.0)
  createdAt   DateTime      @default(now())

  rubric      JudgingRubric @relation(fields: [rubricId], references: [id], onDelete: Cascade)
}

model SubmissionScore {
  id           String     @id @default(uuid())
  submissionId String
  judgeId      String
  score        Float
  feedback     String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  judge        User       @relation(fields: [judgeId], references: [id], onDelete: Cascade)

  @@unique([submissionId, judgeId])
}

model SubmissionComment {
  id           String     @id @default(uuid())
  submissionId String
  userId       String
  content      String
  createdAt    DateTime   @default(now())

  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id          String           @id @default(uuid())
  userId      String
  type        NotificationType
  title       String
  body        String
  data        Json?
  isRead      Boolean          @default(false)
  priority    Priority         @default(MEDIUM)
  challengeId String?
  createdAt   DateTime         @default(now())

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge   Challenge?       @relation(fields: [challengeId], references: [id], onDelete: SetNull)
}

model Conversation {
  id           String    @id @default(uuid())
  participants String[]  // User IDs
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  messages     Message[]
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  type           MessageType  @default(TEXT)
  fileUrl        String?
  fileName       String?
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

model Achievement {
  id          String            @id @default(uuid())
  title       String            @unique
  description String
  badgeUrl    String?
  createdAt   DateTime          @default(now())

  users       UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(uuid())
  userId        String
  achievementId String
  awardedAt     DateTime    @default(now())

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}

model Leaderboard {
  id              String   @id @default(uuid())
  userId          String   @unique
  name            String
  avatar          String?
  innovationScore Float    @default(0.0)
  wins            Int      @default(0)
  submissions     Int      @default(0)
  skills          String[] @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Payment {
  id             String         @id @default(uuid())
  userId         String
  type           PaymentType
  amount         Float
  currency       String         @default("USD")
  status         PaymentStatus  @default(PENDING)
  gateway        PaymentGateway
  gatewayOrderId String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PrizePayout {
  id               String         @id @default(uuid())
  userId           String
  challengePrizeId String
  amount           Float
  status           PaymentStatus  @default(PENDING)
  txRef            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  challengePrize   ChallengePrize @relation(fields: [challengePrizeId], references: [id], onDelete: Cascade)
}

model JobOpportunity {
  id          String        @id @default(uuid())
  companyId   String
  title       String
  description String
  location    String?
  salaryRange String?
  type        String?       // e.g. Contract, Full-time, Internship
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applications Application[]
}

model Contract {
  id          String    @id @default(uuid())
  companyId   String
  userId      String
  terms       String
  amount      Float?
  startDate   DateTime
  endDate     DateTime?
  createdAt   DateTime  @default(now())

  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Application {
  id               String         @id @default(uuid())
  jobOpportunityId String
  userId           String
  resumeUrl        String?
  coverLetter      String?
  status           String         @default("PENDING") // e.g. PENDING, REVIEWED, SHORTLISTED, ACCEPTED, REJECTED
  createdAt        DateTime       @default(now())

  jobOpportunity   JobOpportunity @relation(fields: [jobOpportunityId], references: [id], onDelete: Cascade)
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BlogPost {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  excerpt     String?
  content     String
  category    String?
  tags        String[] @default([])
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AnalyticsEvent {
  id          String   @id @default(uuid())
  name        String
  userId      String?
  properties  Json?
  timestamp   DateTime @default(now())
}
